# Pixel-style portrait profile. Override any value in the environment when
# running install.sh, or edit ~/.config/android-sim/config after installation.
: "${WIDTH:=480}"
: "${HEIGHT:=1071}"
: "${DENSITY:=186}"
: "${MAX_FPS:=120}"

# A single wildcard enables Waydroid's mouse-to-touch translation for all apps.
: "${FAKE_TOUCH:=*}"
: "${MULTI_WINDOWS:=false}"

: "${IMAGE_FLAVOR:=GAPPS}"
: "${INSTALL_HOUDINI:=true}"
: "${INSTALL_MAGISK:=true}"
: "${ENABLE_KWIN_RULE:=true}"
